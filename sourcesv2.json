"cuevana": {
    "enabled": true,
    "priority": 3,
    "index": {
    "url": "https://taladroale.github.io/Warrior/cuepro.json"
    },
    "homeUrls": ["https://cuevana3e.pro/"],
    "movieDetailPrefixes": ["/pelicula/"],
    "seriesDetailPrefixes": ["/serie/"],
    "genreMoviePrefixes": ["/peliculas?genero="],
    "genreSeriesPrefixes": ["/series?genero="],
    "seasonPrefixes": ["/temporada-"],
    "episodePrefixes": ["/episodio-"],

    "serverDecode": {
      "vParam": "?v=",
      "tmdbIdRegex": "tmdb=([0-9]+)"
    },
    "serverBlockTag": "<li class=\"tab-video-item\">",
    "serverItemRegex": "<li[^>]*data-server=\"([^\"]*)\"[^>]*>\\s*<span>(.*?)</span>",
    "languageRegex": "<div class=\"tab-item-name\">\\s*([^<]+)",

    "metadataRegex": {
      "title": "<h1 class=\"title page-title-hero\">(.*?)<span",
      "synopsis": "<h1 class=\"title page-title-hero\">.*?</h1>\\s*<p>(.*?)</p>",
      "rating": "<span class=\"voteav[^\"]*\"[^>]*>([\\d.]+)</span>",
      "year": "<h2 class=\"subtitle\">Año de estreno</h2>\\s*<p>(\\d+)</p>",
      "duration": "<h2 class=\"subtitle\">Cuánto dura.*?</h2>\\s*<p>Duración estima de (.*?)</p>",
      "quality": "Calidad · (\\w+)",
      "genres": "<a href=\"[^\"]*\\?genero=[^\"]*\" class=\"jump-link\">([^<]+)</a>",
      "backdrop": "<(?:div class=\"backdrop-image\"|figure class=\"backdrop\")>.*?<img[^>]*\\bsrc\\s*=\\s*[\"']?([^\"'\\s>]+)",
      "tmdbId": "<meta name=\"tmdb-id\" content=\"([^\"]*)\""
    },
    "popularMoviesRegex": {
      "container": "<div class=\"Title widget-title\">Películas Populares</div>\\s*<ul class=\"MovieList\">(.*?)</ul>",
      "item": "<li>(.*?)</li>",
      "link": "<a\\s+[^>]*href=\"(?:https?://[^/]+)?/(?:pelicula|serie)/([^\"]*)\"",
      "image": "<img[^>]*\\bsrc\\s*=\\s*[\"']?([^\"'\\s>]+)",
      "title": "<div class=\"Title\">(.*?)</div>"
    },
    "seriesMetadataRegex": {
      "title_jsonld": "name",
      "synopsis_jsonld": "description",
      "rating_jsonld": "aggregateRating.ratingValue",
      "actors_jsonld": "actor[].name",
      "title_og": "og:title",
      "synopsis_og": "og:description",
      "backdrop_og": "og:image",
      "title_regex": "<h1 class=\"title\">Serie\\s*(.*?)\\s*</h1>",
      "synopsis_regex": "<h2 class=\"subtitle\">Resumen general</h2>\\s*<p>(.*?)</p>",
      "year_regex": "publicada en el año (\\d{4})",
      "actors_regex": "<h2 class=\"subtitle\">Actores</h2>\\s*<p>(.*?)</p>",
      "genres_section_regex": "<h2 class=\"subtitle\">Categoría</h2>\\s*<p>(.*?)</p>",
      "genre_link_regex": "<a[^>]*class=\"jump-link\"[^>]*>([^<]+)</a>",
      "rating_regex": "\"ratingValue\":\\s*([\\d.]+)",
      "backdrop_regex": "<meta property=\"og:image\" content=\"([^\"]+)\"",
      "tmdb_id_regex": "<meta name=\"tmdb-id\" content=\"([^\"]*)\""
    },
    "heroRegex": {
      "block": "<div class=\"MovieListSldCn\">(.*?)</div>\\s*<div class=\"TpRwCont\"",
      "imageAndTitle": "<img[^>]*\\bsrc\\s*=\\s*[\"']?([^\"'\\s>]+)[\"']?[^>]*\\balt\\s*=\\s*[\"']?Película destacada\\s+([^\"']+)",
      "synopsis": "<p class=\"Info\">.*?</p>\\s*<p>(.*?)</p>"
    },
    "movieListItemRegex": {
      "li": "<li class=\"TPostMv[^\"]*\">(.*?)</li>",
      "link": "<a\\b[^>]*href=\"([^\"]*)\"[^>]*>(.*?)</a>",
      "slug": "/(?:pelicula|serie)/([^\"]*)",
      "image": "<img[^>]*\\bsrc\\s*=\\s*[\"']?([^\"'\\s>]+)",
      "title": "<h2 class=\"Title\">(.*?)</h2>"
    },
    "episodeListItemRegex": {
      "li": "<li class=\"TPostMv[^\"]*\">(.*?)</li>",
      "link": "<a\\b[^>]*href=\"([^\"]*episodio[^\"]*)\"[^>]*>(.*?)</a>",
      "slug": "/(?:serie)/([^\"]*)",
      "image": "<img[^>]*\\bsrc\\s*=\\s*[\"']?([^\"'\\s>]+)",
      "title": "<h2 class=\"Title\">(.*?)</h2>"
    },
    "genrePageItemRegex": {
      "div": "<div class=\"movie-item\">(.*?)</div>\\s*(?:<div class=\"movie-item\">|</div>)",
      "link": "<a\\b[^>]*>(.*?)</a>",
      "slug": "/(?:pelicula|serie)/([^\"]*)",
      "image": "<img[^>]*\\bsrc\\s*=\\s*[\"']?([^\"'\\s>]+)",
      "title": "<p>(.*?)</p>"
    },
    "seasonRegex": "href=\"[^\"]*temporada-(\\d+)\"",
    "seasonEpisodeRegex": {
      "link": "<a\\b[^>]*href=\"([^\"]*episodio[^\"]*)\"[^>]*>(.*?)</a>",
      "title": "<h2 class=\"Title\">(.*?)</h2>",
      "image": "<img[^>]*src=\"([^\"]*)\"[^>]*>"
    }
},

